{
  "extends": "@krishimitra/config/typescript-next",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@krishimitra/shared": [
        "../../packages/shared/src/index.ts"
      ],
      "@krishimitra/ui": [
        "../../packages/ui/src/index.ts"
      ]
    },
    "noEmit": true,
    "isolatedModules": true
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
