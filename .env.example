# ─────────────────────────────────────────────────────────────
# KrishiMitra Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────

# ── Node ──────────────────────────────────────────────────────
NODE_ENV=development

# ── Database (PostgreSQL) ─────────────────────────────────────
DATABASE_URL=postgresql://krishimitra:krishimitra_dev_password@localhost:5432/krishimitra_db?schema=public
POSTGRES_USER=krishimitra
POSTGRES_PASSWORD=krishimitra_dev_password
POSTGRES_DB=krishimitra_db

# ── Redis ─────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── JWT Authentication ────────────────────────────────────────
JWT_SECRET=replace-with-at-least-32-char-random-string
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── CORS ──────────────────────────────────────────────────────
CORS_ORIGIN=http://localhost:3000

# ── NestJS API ────────────────────────────────────────────────
PORT=3001

# ── Next.js Web ───────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── External APIs ─────────────────────────────────────────────
# data.gov.in API key for Agmarknet mandi price data (optional — synthetic data used if not set)
DATA_GOV_API_KEY=

# Open-Meteo is free, no key required
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1

# ── Logging ───────────────────────────────────────────────────
LOG_LEVEL=debug

# ── pgAdmin (local dev GUI only) ──────────────────────────────
PGADMIN_EMAIL=admin@krishimitra.local
PGADMIN_PASSWORD=change-this-password

# ── Scheduler ─────────────────────────────────────────────────
# Cron expression for price ingestion (default: 1:30 AM daily)
PRICE_INGEST_CRON=30 1 * * *

# ── Production (Render + Vercel) ──────────────────────────────
# DATABASE_URL=postgresql://user:pass@host/dbname?sslmode=require
# REDIS_URL=rediss://user:pass@host:port
# NEXT_PUBLIC_API_URL=https://krishimitra-api.onrender.com
# NEXT_PUBLIC_APP_URL=https://krishimitra.vercel.app
