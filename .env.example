# ── NestJS API (set in Render dashboard) ─────────────────────
NODE_ENV=production
PORT=3001
DATABASE_URL=postgresql://user:pass@host/dbname?sslmode=require
REDIS_URL=rediss://user:pass@host:port
JWT_SECRET=generate-a-long-random-secret-here
JWT_EXPIRES_IN=15m

# ── Next.js Web (set in Vercel dashboard) ─────────────────────
NEXT_PUBLIC_API_URL=https://krishimitra-api.onrender.com
NEXT_PUBLIC_APP_URL=https://krishimitra.vercel.app
